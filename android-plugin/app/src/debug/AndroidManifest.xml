<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".benchmark.BenchmarkActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@style/Theme.PowerampStartRadio"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".debug.FeatureAcceptanceActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@style/Theme.PowerampStartRadio" />

        <activity
            android:name=".debug.ProductionFindMusicAcceptanceActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.DUMP"
            android:theme="@style/Theme.PowerampStartRadio" />

        <activity
            android:name=".debug.ProductionComposedFindMusicAcceptanceActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.DUMP"
            android:theme="@style/Theme.PowerampStartRadio" />

        <activity
            android:name=".debug.ControlAdmissionAcceptanceActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@style/Theme.PowerampStartRadio" />

        <activity
            android:name=".debug.IndexingResumeAcceptanceActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:permission="android.permission.DUMP"
            android:theme="@style/Theme.PowerampStartRadio" />

        <activity
            android:name=".debug.ProductionIndexingAcceptanceActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:permission="android.permission.DUMP"
            android:theme="@style/Theme.PowerampStartRadio" />

        <receiver
            android:name=".debug.DebugRadioReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.powerampstartradio.DEBUG_START_RADIO" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".debug.DebugMultiSeedReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.powerampstartradio.DEBUG_MULTI_SEED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
